[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/meta/components/card_xp_item.gd" id="1_card_xp_item"]

[node name="CardXPItem" type="PanelContainer"]
custom_minimum_size = Vector2(120, 70)
