// Vector2Constant:12
	vec2 n_out12p0 = vec2(0.025000, 0.025000);


// FloatOp:14
	float n_out14p0 = n_out15p0 * n_out12p0.x;


// FloatOp:11
	float n_out11p0 = n_out10p0 * n_out14p0;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = vec2(n_out11p0) * n_in9p1 + UV;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_vtx_7, n_out9p0);
	float n_out7p1 = n_out7p0.r;


// VectorOp:8
	vec3 n_out8p0 = n_out3p0 * vec3(n_out7p1);


// FloatConstant:5
