[gd_resource type="TargetingConfig" script_class="TargetingConfig" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/csharp/Targeting/TargetingConfig.cs" id="1_config"]
[ext_resource type="Script" path="res://scripts/csharp/Targeting/Filters/ValidTargetFilter.cs" id="2_valid"]
[ext_resource type="Script" path="res://scripts/csharp/Targeting/Scorers/CompositeScorer.cs" id="3_comp_scorer"]
[ext_resource type="Script" path="res://scripts/csharp/Targeting/Scorers/DistanceScorer.cs" id="4_dist"]
[ext_resource type="Script" path="res://scripts/csharp/Targeting/Scorers/BelowTargetScorer.cs" id="5_below"]
[ext_resource type="Script" path="res://scripts/csharp/Targeting/Constraints/CompositeConstraint.cs" id="6_comp_const"]
[ext_resource type="Script" path="res://scripts/csharp/Targeting/Constraints/RangeConstraint.cs" id="7_range"]
[ext_resource type="Script" path="res://scripts/csharp/Targeting/Constraints/HorizontalConeConstraint.cs" id="8_cone"]

[sub_resource type="Resource" id="ValidTargetFilter_1"]
script = ExtResource("2_valid")

[sub_resource type="Resource" id="DistanceScorer_1"]
script = ExtResource("4_dist")
MaxDistance = 24.0
Weight = 1.0

[sub_resource type="Resource" id="BelowTargetScorer_1"]
script = ExtResource("5_below")
Radius = 6.0
Weight = 5.0

[sub_resource type="Resource" id="CompositeScorer_1"]
script = ExtResource("3_comp_scorer")
Scorers = [SubResource("DistanceScorer_1"), SubResource("BelowTargetScorer_1")]

[sub_resource type="Resource" id="RangeConstraint_1"]
script = ExtResource("7_range")

[sub_resource type="Resource" id="HorizontalConeConstraint_1"]
script = ExtResource("8_cone")
ConeHalfAngle = 30.0
CloseRangeThreshold = 0.5

[sub_resource type="Resource" id="CompositeConstraint_1"]
script = ExtResource("6_comp_const")
Constraints = [SubResource("RangeConstraint_1"), SubResource("HorizontalConeConstraint_1")]

[resource]
script = ExtResource("1_config")
Filter = SubResource("ValidTargetFilter_1")
Scorer = SubResource("CompositeScorer_1")
AttackConstraint = SubResource("CompositeConstraint_1")
AggroRadius = 24.0
