script = ExtResource("1_dialogue_data")
character_name = "Mr. Merriweather"
lines = Array[String](["Why, hello there, young summoner! What wonderful timing! I'm Mr. Merriweather, traveling merchant and purveyor of fine magical goods. I've journeyed far to bring these quality wares to aspiring summoners such as yourself!"])
