script = ExtResource("1_dialogue_data")
character_name = "Mr. Merriweather"
lines = Array[String](["Do let me know if anything catches your eye! I'll be in the area for a while—there are several other summoners I'm hoping to assist today. Such a joy to support the next generation of heroes!"])
