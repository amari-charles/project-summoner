; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fateforged"
run/main_scene="res://scenes/ui/screens/title_screen.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ElementTypes="*res://scripts/core/element_types.gd"
Fonts="*res://scripts/core/fonts.gd"
Loc="*res://localization/localization_service.gd"
CardCatalog="*res://scripts/data/card_catalog.gd"
SummonerCatalog="*res://scripts/data/summoner_catalog.gd"
TraitCatalog="*res://scripts/data/trait_catalog.gd"
ContentCatalog="*res://scripts/data/content_catalog.gd"
CosmeticsCatalog="*res://scripts/data/cosmetics_catalog.gd"
EmotesCatalog="*res://scripts/data/emotes_catalog.gd"
VFXManager="*res://scripts/vfx/vfx_manager.gd"
DamageSystem="*res://scripts/csharp/Combat/DamageSystem.tscn"
HPBarManager="*res://scripts/ui/battle/hp_bar_manager.gd"
ProjectileManager="*res://scripts/projectiles/projectile_manager.gd"
ProfileRepo="*res://scripts/data/json_profile_repository.gd"
AudioManager="*res://scripts/services/audio_manager.gd"
Economy="*res://scripts/services/economy_service.gd"
Collection="*res://scripts/services/collection_service.gd"
CardProgression="*res://scripts/services/card_progression_service.gd"
SummonerProgression="*res://scripts/services/summoner_progression_service.gd"
SummonerSelection="*res://scripts/services/summoner_selection_service.gd"
Decks="*res://scripts/services/deck_service.gd"
RewardService="*res://scripts/services/reward_service.gd"
Shop="*res://scripts/services/shop_service.gd"
BillingCatalog="*res://scripts/billing/billing_catalog.gd"
PlatformBilling="*res://scripts/billing/platform_billing.gd"
Campaign="*res://scripts/services/campaign_service.gd"
BattleContext="*res://scripts/core/battle_context.gd"
EventContext="*res://scripts/core/event_context.gd"
NavigationContext="*res://scripts/services/navigation_context.gd"
CapabilityManager="*res://scripts/services/capability_manager.gd"
GameStateEvents="*res://scripts/services/game_state_events.gd"
EventSequencer="*res://scripts/services/event_sequencer.gd"
DialogueManager="*res://scripts/services/dialogue_manager.gd"
DevConsole="*res://scripts/debug/dev_console.gd"
DebugSnapshots="*res://scripts/debug/debug_snapshots.gd"
ModifierSystem="*res://scripts/systems/modifier_system.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
SceneCoordinator="*res://scripts/services/scene_coordinator.gd"
RedirectManager="*res://scripts/managers/redirect_manager.gd"
PhysicsLayers="*res://scripts/core/physics_layers.gd"
SpellTargetingManager="*res://scripts/ui/battle/spell_targeting_manager.gd"
FPSTestTool="*res://scripts/debug/fps_test_tool.gd"
SpatialGrid="*res://scripts/csharp/Systems/SpatialGrid.tscn"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Fateforged"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://resources/visual/base_theme.tres"

[layer_names]

3d_physics/layer_1="Ground Units"
3d_physics/layer_2="Flying Units"
3d_physics/layer_3="Terrain"
3d_physics/layer_4="Projectiles"

[physics]

common/physics_interpolation=true
